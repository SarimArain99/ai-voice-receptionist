# Sadaa Phase 2 — real phone calls (Twilio) + WhatsApp
# Copy to .env.local for local tests. Production values go in Vercel
# (Project Settings → Environment Variables). Never commit real values.

# Twilio (free trial, no card): Account SID + Auth Token from twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# WhatsApp Cloud API (Meta, free tier: 1,000 service messages/month)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any secret string you choose; Meta must send the same value when verifying the webhook.
WHATSAPP_VERIFY_TOKEN=

# Optional: Hugging Face token (free account) for transcribing WhatsApp voice notes.
HF_TOKEN=
